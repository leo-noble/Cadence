# Copy this file to .env (which is gitignored) and fill in your own
# Supabase project's values — find both under Project Settings → API in
# https://supabase.com/dashboard.
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key, not the service_role
# key. It's meant to be shipped to browsers and is safe in a client build
# as long as Row Level Security is enabled on your tables — never put the
# service_role key in a Vite app or any other client-side code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public VAPID key for Web Push (the private key stays server-side in
# Supabase — see the send-due-reminders Edge Function). This one is
# meant to be public, same as the anon key above.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
